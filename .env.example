NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Minutes to ADD to the MetaTrader 5 time to get your local time.
# 210 = 3 hours 30 minutes  (15:30:18 on MT5 becomes 19:00:18)
NEXT_PUBLIC_MT5_OFFSET_MINUTES=210

# Minutes your local time is ahead of UTC (330 = India). Used to find the trading session of each trade.
NEXT_PUBLIC_LOCAL_UTC_OFFSET_MINUTES=330
